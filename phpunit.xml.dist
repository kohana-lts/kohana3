<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="modules/unittest/bootstrap_all_modules.php"
         colors="true"
         convertDeprecationsToExceptions="true"
         beStrictAboutOutputDuringTests="false">
	<testsuites>
		<testsuite name="system">
			<directory suffix="Test.php">system/tests</directory>
		</testsuite>
		<testsuite name="modules">
			<directory suffix="Test.php">modules/cache/tests</directory>
			<directory suffix="Test.php">modules/image/tests</directory>
			<directory suffix="Test.php">modules/minion/tests</directory>
			<directory suffix="Test.php">modules/userguide/tests</directory>
		</testsuite>
	</testsuites>
	<php>
		<ini name="error_reporting" value="-1"/>
		<ini name="date.timezone" value="UTC"/>
	</php>
</phpunit>
